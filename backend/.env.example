# Copy to .env and adjust. Loaded by uvicorn's --env-file flag.

# Where Ollama listens. Leave as-is when it runs on this machine.
OLLAMA_HOST=http://localhost:11434

# Must be a model that supports tool calling, or the agent never searches.
OLLAMA_MODEL=qwen3:1.7b

# Where SearXNG listens. Only used by /api/health today — the agent still searches
# through ddgs. Matches the port docker-compose.yml publishes.
SEARXNG_HOST=http://localhost:8080
